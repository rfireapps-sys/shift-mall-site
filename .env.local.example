# このファイルをコピーして .env.local という名前で保存すると、
# ローカルの `npm run dev` でもパスワードゲートを試せます（任意）。
# Vercel側は Settings > Environment Variables で同じ名前の変数を設定してください。
# 一般公開するタイミングで、Vercelからこの2つの変数を削除すれば保護は解除されます。

SITE_BASIC_AUTH_USER=admin
SITE_BASIC_AUTH_PASS=change-me

# 事前登録フォーム（/api/preregister）の送信先 Webhook（任意）。
# 未設定の場合、登録メールアドレスはサーバーログに出力されるだけになります。
# 例: Google Apps Script の Webhook、Zapier/Make の Webhook、ESP の受信API など。
PREREGISTER_WEBHOOK_URL=
